<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Trello & Mobile Test Automation Suite">
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>
    <test name="API Tests">
        <classes>
            <class name="com.automation.APITests"/>
        </classes>
    </test>
    <test name="UI Tests">
        <classes>
            <class name="com.automation.UITests"/>
        </classes>
    </test>
</suite>
